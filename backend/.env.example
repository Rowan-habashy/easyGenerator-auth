PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Required. MongoDB must be a replica set (transactions)
MONGODB_URI=mongodb://localhost:27017/easygenerator?replicaSet=rs0

# Rate limit counters: memory (default, single instance) or redis (multi-instance)
RATE_LIMIT_STORE=memory
# Only needed when RATE_LIMIT_STORE=redis
# REDIS_URL=redis://your-redis-host:6379
JWT_SECRET=

# ---- Optional overrides (defaults shown) ----
TRUST_PROXY_HOPS=1
HSTS_MAX_AGE_SECONDS=31536000

JWT_ACCESS_EXPIRES_IN=15m
JWT_ALGORITHM=HS256

REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/auth
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

SESSION_TTL_DAYS=30
REFRESH_TTL_DAYS=7
REFRESH_GRACE_SECONDS=10
REFRESH_TOKEN_BYTES=48
BCRYPT_ROUNDS=12
MAX_TX_ATTEMPTS=3
MAX_COMMIT_RETRIES=3
PURGE_AFTER_DAYS=7

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

SIGNIN_MAX_FAILURES_PER_IP=5
SIGNIN_MAX_FAILURES_PER_EMAIL=10
SIGNIN_FAILURE_WINDOW_MINUTES=15
SIGNIN_MAX_MEMORY_KEYS=10000
