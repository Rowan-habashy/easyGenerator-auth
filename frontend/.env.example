# Dev server
VITE_DEV_PORT=5173
VITE_BACKEND_URL=http://localhost:3000

# Leave empty in dev (the Vite proxy handles /api). Set to the API origin in production.
VITE_API_BASE_URL=

# Retry policy for 429 / 503 SERVICE_UNAVAILABLE
VITE_RETRY_MAX_ATTEMPTS=3
VITE_RETRY_BASE_DELAY_MS=500
VITE_RETRY_MAX_DELAY_MS=5000

# Request timeout
VITE_REQUEST_TIMEOUT_MS=10000
